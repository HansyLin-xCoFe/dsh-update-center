{
    "name":  "dsh-update-center",
    "version":  "1.2.0",
    "private":  true,
    "description":  "Check DSH releases, read the highlights, and update to the latest version with one click — from Settings → General or the bottom-left prompt.",
    "type":  "module",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./npm-invocation":  "./npm-invocation.mjs",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "update-helper.mjs",
                  "npm-invocation.mjs",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg",
                  "README.en.md"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "@deepseek-ai/dsh-client-locale",
                                              "@deepseek-ai/dsh-client-ui-settings"
                                          ]
                           }
            },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/HansyLin-xCoFe/dsh-update-center.git"
                   },
    "homepage":  "https://github.com/HansyLin-xCoFe/dsh-update-center",
    "author":  {
                   "name":  "HansyLin-xCoFe",
                   "url":  "https://github.com/HansyLin-xCoFe"
               },
    "license":  "MIT",
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "deepseek",
                     "updater",
                     "web-ui"
                 ],
    "engines":  {
                    "dsh":  ">=0.2.1-rc.2"
                }
}
